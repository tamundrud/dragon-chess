{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dragon-chess.local/agent-review.schema.json",
  "title": "Transactional branch review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "complete",
    "reviewed_sha",
    "verdict",
    "findings",
    "re_review_required"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "complete": {
      "const": true
    },
    "reviewed_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "verdict": {
      "enum": [
        "pass",
        "changes_required",
        "needs_human"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "title",
          "path",
          "line",
          "description",
          "recommendation"
        ],
        "properties": {
          "severity": {
            "enum": [
              "critical",
              "major",
              "minor"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "recommendation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "re_review_required": {
      "type": "boolean"
    }
  }
}
